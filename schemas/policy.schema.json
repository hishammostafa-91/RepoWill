          "default": "strict-mainline"
        },
        "protected_branches": {
          "type": "array",
          "default": [
            "main"
          ],
          "items": {
            "type": "string"
          }
        },
        "push": {
          "$ref": "#/$defs/Push",
          "default": {
            "allow_force": "never",
            "protected_direct": "after-local-merge",
            "remote_deletions": "approval",
            "verified_commits": "warn"
          }
        },
        "stacked_patterns": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "stale_branch_days": {
          "type": "integer",
          "format": "int64",
          "default": 14
        },
        "tags": {
          "$ref": "#/$defs/Tags",
          "default": {
            "annotated": true,
            "only_on": [
              "main"
            ],
            "pattern": "^v(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$",
            "protected": true
          }
        }
      },
      "additionalProperties": false
    },
    "WorkflowModel": {
      "type": "string",
      "enum": [
        "strict-mainline",
        "github-flow",
        "gitflow",
        "custom"
      ]
    }
  }
}
